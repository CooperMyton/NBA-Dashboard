# Backend + ETL image (shared). Build context is the repo root.
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

# uv from the official image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Install dependencies first (cache-friendly). Requires a committed uv.lock.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# Application code
COPY backend ./backend
COPY etl ./etl
COPY ml ./ml
COPY docker/start.sh ./docker/start.sh
RUN chmod +x ./docker/start.sh

# Migrate-then-serve lives in the image so every host (compose, Render, any PaaS) boots the
# same way and no platform-specific start-command override is needed. The script honours
# $PORT when the host sets one.
EXPOSE 8000
CMD ["./docker/start.sh"]
