# Frontend build-time config (Vite). Copy to .env.local for local overrides.

# Base URL for API calls. Default "/api/v1" is same-origin — correct for local dev
# (Vite proxy) and the nginx-served Docker image (nginx proxies /api to the backend).
# For a static cloud host (Cloudflare Pages/Vercel) where the API is a different origin,
# set this to the backend's public URL, e.g. https://api.example.com/api/v1
# VITE_API_BASE_URL=/api/v1
