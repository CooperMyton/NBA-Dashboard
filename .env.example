# Copy to .env and fill in. Never commit .env (see .gitignore).

# --- Environment ---
ENVIRONMENT=dev

# --- Database (async driver required: postgresql+asyncpg) ---
DATABASE_URL=postgresql+asyncpg://nba:nba@localhost:5432/nba
# Credentials used by the Postgres container in docker compose:
POSTGRES_USER=nba
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nba

# --- Redis (cache + rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- balldontlie.io (Free tier) — sign up for a key at https://www.balldontlie.io/ ---
BALLDONTLIE_API_KEY=
BALLDONTLIE_BASE_URL=https://api.balldontlie.io/v1
# Free tier limit is 5 requests/minute (see docs/data_source.md):
PROVIDER_RATE_LIMIT_PER_MIN=5

# --- API ---
API_RATE_LIMIT_PER_MIN=60
# Comma-separated allowed CORS origins (the frontend URL[s]). For a same-origin deploy
# (nginx proxy) this can stay as the local dev default.
CORS_ORIGINS=http://localhost:5173
